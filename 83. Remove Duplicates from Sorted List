class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        ListNode tr=head;
        while(tr!=null && tr.next!=null){
            if(tr.val==tr.next.val){
                tr.next=tr.next.next;
            }
            else{
                tr=tr.next;
            }
        }
         return head;
    }
}
