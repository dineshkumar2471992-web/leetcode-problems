class Solution {
    public boolean isPalindrome(String s) {
          String k=s.toLowerCase();
        k=k.replaceAll("[^a-z0-9]","");
        int n=k.length();
        int i=0,j=n-1;
        while(i<j){
            if(k.charAt(i)!=k.charAt(j)){
                return false;
            }
            else{
            i++;
            j--;
        }
        }
        return true;
        
    }
}
