class Solution {
    public ListNode removeElements(ListNode head, int val) {
      ListNode nn=new ListNode(0);
      nn.next=head;
      ListNode d=nn;
     while(d!=null && d.next!=null){
        if(d.next.val==val){
            d.next=d.next.next;
        }
        else{
            d=d.next;
        }
     }
     return nn.next;  
    }
}
